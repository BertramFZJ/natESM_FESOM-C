FC = mpiifx
CC = mpiicx
LINK = $(FC)

MPIFLAGS = -DUSE_MPI
# MPIFLAGS = 
FCFLAGS = -O3  -march=native -funroll-loops -heap-arrays 0 $(MPIFLAGS)
# FCFLAGS = $(MPIFLAGS) -g -traceback -O0 -fpe-trap=invalid,overflow,zero
# FCFLAGS = -O3 -qopenmp -march=native -funroll-loops -heap-arrays 0 $(MPIFLAGS)

.SUFFIXES: .F90 .o

## PATH TO GOTM TURBULENCE
GOTMDIR      = $(PWD)/../libs-SRC/turbulence/lib
GOTMLIB      = -L$(GOTMDIR) -lturbulence
GOTMINCS     = -I$(GOTMDIR)

## PATH TO NETCDF
# export LD_LIBRARY_PATH=/usr/local/netcdf-intel/lib:$LD_LIBRARY_PATH
NETCDFINC = -I/usr/local/netcdf-intel/include
NETCDFLIB = -L/usr/local/netcdf-intel/lib -lnetcdff -lnetcdf

## PATH TO THREAD AFFINITY LIBRARY
TATHDIR      = $(PWD)/../libs-SRC/threadAffinityLib/lib
TATHLIB      = -L$(TATHDIR) -lTATH
TATHINCS     = -I$(TATHDIR)

LIBS = $(TATHLIB) $(GOTMLIB)  $(NETCDFLIB)
INCS = $(TATHINCS) $(GOTMINCS) $(NETCDFINC)

# NAME OF THE EXECUTABLES
EXE = fesom_coast.exe

.F90.o:
	$(FC) $(FCFLAGS) $(INCS) -c $*.F90

OBJECTS= fv_var.o                  \
      gen_modules_partitioning_c.o \
      timerLibFortran.o            \
      profilingTimers.o            \
      gen_modules_rotate_grid_c.o  \
      gen_halo_exchange_c.o        \
      fv_utilit.o               \
      oce_mesh_c.o                 \
      fv_vert_coord.o           \
      fv_sbc.o                  \
      fv_obc.o                  \
      fv_obc_2d.o               \
      fv_ic.o                   \
      fv_read_run.o             \
      fv_ini.o                  \
      fv_mesh_array.o           \
      fv_gradients.o            \
      fv_3D_vel.o               \
      fv_advection.o            \
      fv_average_dynamic.o      \
      fv_mixing.o               \
      fv_output.o               \
      fv_pressure_new.o         \
      fv_viscosity.o            \
      fv_tracer.o               \
      fv_tide_potential.o       \
      fv_ncoutput.o             \
      fv_sediment.o      \
      fv_sediment_adv.o      \
      fv_output_nc_TMP.o \
      fv_main.o  

#--------------------------------------------------

$(EXE): $(OBJECTS)
	 $(LINK) $(FCFLAGS) -qopenmp -o $(EXE) $(OBJECTS) $(LIBS)

all: $(EXE)

clean :
	rm -f *~ *.o *.mod $(EXE)

allclean :
	$(MAKE) clean

#--------------------------------------------------

